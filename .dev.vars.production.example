# Production secrets for Cloudflare Workers deploy
# Copy to .dev.vars.production and fill in real values
# .dev.vars.production is gitignored – never commit real secrets
#
# Usage: npm run deploy
# (Uploads secrets to Cloudflare, then builds and deploys)

AUTH_SECRET=your-production-secret-from-openssl-rand-base64-32
AUTH_URL=https://monzo-1p-challenge-calculator.online
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:pass@host.region.aws.neon.tech/dbname?sslmode=require
AUTH_RESEND_KEY=re_your_resend_api_key
AUTH_RESEND_FROM=1p Challenge <noreply@monzo-1p-challenge-calculator.online>
CRON_SECRET=generate-with-openssl-rand-base64-32
