# 1p Challenge Calculator - Environment Variables
# Copy to .env.local and fill in as needed.

# === Required for production (Auth + DB) ===
AUTH_SECRET=                    # Generate: openssl rand -base64 32
AUTH_URL=                       # Production: https://your-domain.com
DATABASE_URL=                   # Neon pooled: postgresql://user:pass@host/db?sslmode=require
DIRECT_URL=                     # Neon direct: postgresql://user:pass@host/db?sslmode=require

# === Resend (magic link + monthly transfer emails) ===
AUTH_RESEND_KEY=                # From https://resend.com
AUTH_RESEND_FROM=               # e.g. "1p Challenge <noreply@yourdomain.com>"

# === Cron (monthly transfer reminder on the 1st) ===
CRON_SECRET=                    # Random secret; Bearer token for /api/cron/monthly-transfer

# === Optional ===
# NEXT_PUBLIC_ANALYTICS_ID=

# === Cloudflare (set in Workers Build / secrets) ===
# Same vars as above; AUTH_URL must match your Worker URL
